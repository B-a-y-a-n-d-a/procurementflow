# Copy this file to `.env.local` (git-ignored) and fill in values.
# NOTE: The current build is 100% front-end and does NOT need any of these to run.
# They are reserved for upcoming features (see GitHub issues).

# GEMINI_API_KEY: Google Gemini API key for planned AI features
# (e.g. AI tender/bid analysis). Get one at https://aistudio.google.com/apikey
# Never commit a real key, and never expose it in browser code - call Gemini from a server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted (used for self-referential links / OAuth callbacks).
# Locally this is http://localhost:3000
APP_URL="http://localhost:3000"
