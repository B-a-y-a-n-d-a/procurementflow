# Copy to `.env` (git-ignored) to override Docker Compose defaults. Everything is optional.

# CIVIC AI - Google Gemini (server-side only; never exposed to the browser).
# Without a key CIVIC AI runs in DETERMINISTIC mode with the same grounded outputs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MySQL credentials used by the mysql and backend containers
DB_USER=civicflow
DB_PASSWORD=civicflow
DB_ROOT_PASSWORD=civicflow-root

# Host ports (change if something already uses them)
FRONTEND_PORT=3000
BACKEND_PORT=8081
MYSQL_PORT=3306

# Sign-in token signing key (>= 32 random characters). Blank = random per start, so everyone
# is signed out whenever the backend restarts.
AUTH_TOKEN_SECRET=

# Only used to REGENERATE database/civicflow.sql (see database/README.md): the shared
# password given to every seeded account.
SEED_USER_PASSWORD=
