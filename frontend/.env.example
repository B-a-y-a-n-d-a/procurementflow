# Frontend (Vite) settings - all optional. Copy to .env.local (git-ignored).
# NOTE: never put secrets here; anything prefixed VITE_ is bundled into browser code.
# The Gemini key belongs to the BACKEND (see ../.env.example).

# API base path used by the browser (default: same-origin /api)
# VITE_API_URL=/api

# Where the Vite dev server proxies /api (default: http://localhost:8081 = backend in Docker)
# VITE_API_PROXY=http://localhost:8080
